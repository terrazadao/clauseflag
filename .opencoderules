/src /app # Next.js app router pages /components # Reusable UI components /ui # Base components (Button, Card, etc.) /contract # Contract-specific components /lib # Core business logic /parsers # Document parsing (pdf, docx) /ai # AI prompt templates & handlers /risk-engine # Risk scoring & classification /payment # Stripe integration /types # TypeScript type definitions /utils # Generic utilities /config # Configuration & constants

- Environment variables for all secrets in `.env.local`
- Never commit secrets or API keys
- Write unit tests for parsers, risk engine, AI formatting

### INNOVATION
- Show real-time progress: upload → parsing → analyzing → results
- Implement optimistic UI updates where appropriate
- Smart document chunking: preserve clause context across chunks
- Jurisdiction-aware risk adjustment (US/EU/UAE)
- Clause fingerprinting: hash content for duplicate detection & caching
- Return confidence scores with all AI analyses
- Progressive enhancement: basic functionality without JS

## Database Schema (Supabase PostgreSQL)

```sql
CREATE TABLE contracts (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  user_email TEXT,
  file_name TEXT NOT NULL,
  file_size INTEGER,
  file_url TEXT,
  jurisdiction TEXT CHECK (jurisdiction IN ('US', 'EU', 'UAE')),
  status TEXT DEFAULT 'processing' CHECK (status IN ('processing', 'completed', 'failed')),
  error_message TEXT,
  created_at TIMESTAMP DEFAULT NOW(),
  processed_at TIMESTAMP
);

CREATE TABLE clauses (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  contract_id UUID REFERENCES contracts(id) ON DELETE CASCADE,
  clause_type TEXT NOT NULL,
  risk_level TEXT CHECK (risk_level IN ('low', 'medium', 'high')),
  original_text TEXT NOT NULL,
  explanation TEXT,
  why_it_matters TEXT,
  confidence_score DECIMAL(3,2),
  position_in_document INTEGER,
  created_at TIMESTAMP DEFAULT NOW()
);

CREATE TABLE payments (
  id UUID PRIMARY KEY DEFAULT uuid_generate_v4(),
  contract_id UUID REFERENCES contracts(id),
  stripe_payment_id TEXT UNIQUE,
  amount INTEGER NOT NULL,
  currency TEXT DEFAULT 'usd',
  status TEXT DEFAULT 'pending',
  created_at TIMESTAMP DEFAULT NOW()
);

CREATE INDEX idx_contracts_email ON contracts(user_email);
CREATE INDEX idx_contracts_status ON contracts(status);
CREATE INDEX idx_clauses_contract_risk ON clauses(contract_id, risk_level);
CREATE INDEX idx_payments_stripe ON payments(stripe_payment_id);
