Copy// /src/lib/ai/analyze-clause.ts
import { OpenAI } from 'openai';
import { ClauseAnalysis, Jurisdiction } from '@/types/contract';

const openai = new OpenAI({ apiKey: process.env.OPENAI_API_KEY });

const SYSTEM_PROMPT = `You are a contract clause risk analyzer. Your job is to identify high-risk clauses and explain them in plain English to non-lawyers.

CRITICAL RULES:
- Only flag clauses that pose REAL risk to the signing party
- Use plain English (8th grade reading level)
- Be conservative and clear
- Never provide legal advice
- Return ONLY valid JSON, no markdown formatting

Risk criteria by clause type:
- Termination: Unfavorable notice periods, one-sided termination rights
- Liability: Unlimited liability, inadequate caps, broad exclusions
- Indemnity: One-sided obligations, broad scope, no limitations
- Auto-renewal: Automatic renewal without clear opt-out
- Payment: Harsh penalties, unclear terms, one-sided enforcement
- Governing Law: Unfavorable jurisdiction, mandatory arbitration
- IP Ownership: Broad IP transfer, unclear ownership
- Non-compete: Overly broad scope, long duration, wide geography`;

export async function analyzeClause(
  clauseText: string,
  jurisdiction: Jurisdiction,
  contractType?: string
): Promise<ClauseAnalysis> {
  try {
    const response = await openai.chat.completions.create({
      model: 'gpt-4o-mini',
      temperature: 0.2,
      response_format: { type: 'json_object' },
      messages: [
        { role: 'system', content: SYSTEM_PROMPT },
        {
          role: 'user',
          content: `Analyze this clause for risk:

CLAUSE TEXT:
"${clauseText}"

CONTEXT:
- Jurisdiction: ${jurisdiction}
${contractType ? `- Contract Type: ${contractType}` : ''}

Return JSON with this exact structure:
{
  "clause_type": "termination|liability|indemnity|auto_renewal|payment_penalty|governing_law|ip_ownership|non_compete",
  "is_risky": true|false,
  "risk_level": "low|medium|high",
  "explanation": "Plain English explanation (max 150 words)",
  "why_it_matters": "Practical implications for the signer (max 100 words)",
  "confidence": 0.0-1.0
}`
        }
      ],
      max_tokens: 500
    });

    const content = response.choices[0]?.message?.content;
    if (!content) throw new Error('Empty AI response');

    const analysis = JSON.parse(content) as ClauseAnalysis;
    
    // Validate response structure
    if (!analysis.clause_type || typeof analysis.is_risky !== 'boolean') {
      throw new Error('Invalid AI response structure');
    }

    return analysis;
  } catch (error) {
    console.error('AI analysis failed:', error);
    throw new Error('Failed to analyze clause. Please try again.');
  }
}
