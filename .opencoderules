Clause Detection Algorithm
Copy// /src/lib/parsers/split-clauses.ts
export function splitIntoClauses(documentText: string): string[] {
  // Remove excessive whitespace
  const normalized = documentText.replace(/\s+/g, ' ').trim();
  
  // Split by common clause indicators
  const patterns = [
    /\d+\.\s+[A-Z]/g,           // Numbered sections: "1. Termination"
    /\n\n[A-Z][A-Z\s]+:/g,       // Headers: "GOVERNING LAW:"
    /Article\s+\d+/gi,          // "Article 5"
    /Section\s+\d+/gi,          // "Section 3"
  ];

  let clauses: string[] = [];
  let lastIndex = 0;

  patterns.forEach(pattern => {
    const matches = [...normalized.matchAll(pattern)];
    matches.forEach(match => {
      if (match.index && match.index > lastIndex) {
        const clause = normalized.slice(lastIndex, match.index).trim();
        if (clause.length >= 50) { // Minimum clause length
          clauses.push(clause);
        }
        lastIndex = match.index;
      }
    });
  });

  // Add remaining text
  if (lastIndex < normalized.length) {
    const finalClause = normalized.slice(lastIndex).trim();
    if (finalClause.length >= 50) {
      clauses.push(finalClause);
    }
  }

  // If no clauses detected, split by paragraph
  if (clauses.length === 0) {
    clauses = normalized.split(/\n\n+/)
      .map(c => c.trim())
      .filter(c => c.length >= 50 && c.length <= 2000);
  }

  return clauses;
}
